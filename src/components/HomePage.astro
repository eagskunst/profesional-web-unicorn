---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import type { Language } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Language;
  posts: CollectionEntry<'blog'>[];
}

const { lang, posts } = Astro.props;
const t = useTranslations(lang);
const blogUrl = getRelativeLocaleUrl(lang, 'blog');
const pageTitle = lang === 'es' ? 'Emmanuel Guerra - Ingeniero de Software Senior' : 'Emmanuel Guerra - Senior Software Engineer';
const pageDescription = lang === 'es'
  ? 'Portafolio de Emmanuel Guerra, Ingeniero de Software Senior con 8 años de experiencia en mobile, backend e integraciones de IA.'
  : 'Portfolio of Emmanuel Guerra, Senior Software Engineer with 8 years of experience in mobile, backend, and AI integrations.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image='/self_photo_new.png'
  lang={lang}
>
  <Nav lang={lang} />

  <main class='pt-[100px] flex flex-col gap-[120px] pb-[120px]'>
    <section class='relative w-full min-h-[60vh] flex flex-col items-center justify-center px-6 overflow-hidden'>
      <canvas id='hero-network' class='absolute inset-0 -z-10 pointer-events-none block w-full h-full' aria-hidden='true'></canvas>
      <div class='flex flex-col items-center text-center gap-6 mt-12'>
        <div class='w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden mb-6 relative'>
          <div class='absolute inset-0 bg-graphite-primary-container/20 rounded-full blur-xl -z-10'></div>
          <img alt='Emmanuel Guerra portrait' class='w-full h-full object-cover object-center drop-shadow-2xl' src='/self_photo_new.png' width='600' height='548' fetchpriority='high'>
        </div>
        <h1 class='font-geist text-4xl md:text-6xl font-bold text-graphite-primary tracking-tight'>Emmanuel Guerra</h1>
        <h2 class='font-mono text-sm font-medium text-graphite-tertiary-fixed-dim uppercase tracking-widest'>{t('hero.role')}</h2>
      </div>
    </section>

    <section class='w-full max-w-7xl mx-auto px-6 md:px-16 section-gradient rounded-3xl p-8 md:p-12 relative overflow-hidden' id='about'>
      <div class='grid grid-cols-1 lg:grid-cols-2 gap-10 md:gap-16 items-center relative z-10'>
        <div class='flex flex-col justify-center'>
          <h3 class='font-mono text-xs font-bold text-graphite-on-surface-variant mb-6 tracking-widest uppercase'>{t('about.heading')}</h3>
          <p class='text-lg text-graphite-on-surface mb-4'>{t('about.p1')}</p>
          <ul class='list-disc list-inside space-y-1 text-lg text-graphite-on-surface mb-4'>
            {lang === 'es' ? (
              <>
                <li>¿Una funcionalidad completa en una semana? <strong class='text-graphite-primary'>Hecho.</strong></li>
                <li>¿Un crash de regresión que no tiene sentido? <strong class='text-graphite-primary'>Solucionado.</strong></li>
                <li>¿Animaciones y componentes raros sin librerías? <strong class='text-graphite-primary'>Construidos.</strong></li>
                <li>¿Compilar librerías nativas? <strong class='text-graphite-primary'>Dockerizado.</strong></li>
                <li>¿Migración completa de base de datos? <strong class='text-graphite-primary'>Sí, pero no los viernes.</strong></li>
              </>
            ) : (
              <>
                <li>A full feature in a week? <strong class='text-graphite-primary'>Done it.</strong></li>
                <li>A regression crash that makes no sense? <strong class='text-graphite-primary'>Fixed it.</strong></li>
                <li>Weird animations and components without libraries? <strong class='text-graphite-primary'>Built them.</strong></li>
                <li>Compile native libraries? <strong class='text-graphite-primary'>Dockerized it.</strong></li>
                <li>Full DB migration? <strong class='text-graphite-primary'>Yeah, but not on Fridays.</strong></li>
              </>
            )}
          </ul>
          <p class='text-lg text-graphite-on-surface mb-6'>{t('about.p2')}</p>
          <p class='text-base text-graphite-on-surface-variant'>{t('about.p3')}</p>
          <p class='text-base text-graphite-on-surface-variant'>{t('about.p4')}</p>
        </div>
        <div class='glass-panel p-6 md:p-8 rounded-xl w-full max-w-sm md:max-w-xl lg:max-w-2xl mx-auto overflow-hidden'>
          <div class='logo-track'>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/thegrint.jpg' alt='TheGrint' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/banco.jpg' alt='Banco de Crédito e Inversiones' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/shokworks.png' alt='ShokWorks' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/kinesis.jpg' alt='Kinesis.Money' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/liga-dimayor.png' alt='Liga Dimayor' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/thegrint.jpg' alt='TheGrint' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/banco.jpg' alt='Banco de Crédito e Inversiones' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/shokworks.png' alt='ShokWorks' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/kinesis.jpg' alt='Kinesis.Money' loading='lazy'>
            </div>
            <div class='client-logo rounded bg-graphite-surface-container-highest/50 opacity-80 hover:opacity-100 transition-opacity'>
              <img src='/img/clients/liga-dimayor.png' alt='Liga Dimayor' loading='lazy'>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class='w-full max-w-7xl mx-auto px-6 md:px-16' id='projects'>
      <h3 class='font-mono text-xs font-bold text-graphite-on-surface-variant mb-12 tracking-widest uppercase pl-4 border-l-2 border-graphite-primary-container'>{t('projects.heading')}</h3>
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8'>
        <a href='https://play.google.com/store/apps/details?id=com.eagskunst.apps.xchange' target='_blank' rel='noopener noreferrer' class='glass-panel rounded-xl overflow-hidden group cursor-pointer hover:-translate-y-1 transition-transform duration-300'>
          <div class='h-48 w-full bg-graphite-surface-container-highest overflow-hidden relative'>
            <img class='w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500' src='/img/xchange.png' alt='XChange app screenshot' width='600' height='1200' loading='lazy'>
          </div>
          <div class='p-6'>
            <h4 class='font-geist text-xl font-medium text-graphite-primary mb-2'>XChange</h4>
            <p class='text-base text-graphite-on-surface-variant line-clamp-2 mb-4'>{t('projects.xchange.description')}</p>
            <div class='flex flex-wrap gap-2'>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Android</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Kotlin</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Python</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Mongo</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Adobe XD</span>
            </div>
          </div>
        </a>

        <a href='https://play.google.com/store/apps/details?id=com.eagskunst.emmanuel.gamingnews' target='_blank' rel='noopener noreferrer' class='glass-panel rounded-xl overflow-hidden group cursor-pointer hover:-translate-y-1 transition-transform duration-300'>
          <div class='h-48 w-full bg-graphite-surface-container-highest overflow-hidden relative'>
            <img class='w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500' src='/img/gamingnews.png' alt='GamingNews app screenshot' width='600' height='1200' loading='lazy'>
          </div>
          <div class='p-6'>
            <h4 class='font-geist text-xl font-medium text-graphite-primary mb-2'>GamingNews</h4>
            <p class='text-base text-graphite-on-surface-variant line-clamp-2 mb-4'>{t('projects.gamingnews.description')}</p>
            <div class='flex flex-wrap gap-2'>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Android</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Kotlin</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Stich</span>
            </div>
          </div>
        </a>

        <a href='https://github.com/eagskunst/dev-space-cleaner' target='_blank' rel='noopener noreferrer' class='glass-panel rounded-xl overflow-hidden group cursor-pointer hover:-translate-y-1 transition-transform duration-300'>
          <div class='h-48 w-full bg-graphite-surface-container-highest overflow-hidden relative'>
            <img class='w-full h-full object-contain p-6 opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500' src='/img/dev-space-cleaner-logo.png' alt='Dev Space Cleaner logo' width='300' height='300' loading='lazy'>
          </div>
          <div class='p-6'>
            <h4 class='font-geist text-xl font-medium text-graphite-primary mb-2'>Dev Space Cleaner</h4>
            <p class='text-base text-graphite-on-surface-variant line-clamp-2 mb-4'>{t('projects.devspace.description')}</p>
            <div class='flex flex-wrap gap-2'>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Tauri</span>
              <span class='px-3 py-1 bg-graphite-surface-container-highest text-graphite-tertiary-container font-mono text-xs rounded'>Rust</span>
            </div>
          </div>
        </a>
      </div>
    </section>

    <section class='w-full py-24 flex flex-col items-center justify-center text-center relative overflow-hidden' id='contact'>
      <div class='absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-graphite-surface-variant/40 via-graphite-bg to-graphite-bg -z-10'></div>
      <h2 class='font-geist text-4xl md:text-6xl font-bold text-graphite-primary mb-8 tracking-tighter'>{t('contact.heading')}</h2>
      <a class='inline-flex items-center gap-2 px-8 py-4 bg-graphite-primary-container text-graphite-on-primary-fixed font-geist text-xl font-bold rounded hover:bg-graphite-primary-fixed-dim transition-colors shadow-[0_0_20px_rgba(232,235,28,0.2)] hover:shadow-[0_0_30px_rgba(232,235,28,0.4)]' href='mailto:contact@eagskunst.com'>
        <span class='material-symbols-outlined'>mail</span>
        {t('contact.cta')}
      </a>
    </section>

    <section class='w-full max-w-7xl mx-auto px-6 md:px-16 mb-12' id='blog'>
      <div class='flex justify-between items-end mb-8'>
        <h3 class='font-mono text-xs font-bold text-graphite-on-surface-variant tracking-widest uppercase pl-4 border-l-2 border-graphite-primary-container'>{t('blog.heading')}</h3>
        <a href={blogUrl} class='text-graphite-tertiary-container hover:text-graphite-tertiary-fixed-dim transition-colors font-mono text-sm'>{t('blog.readMore')} →</a>
      </div>
      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        {posts.slice(0, 3).map((post) => (
          <a href={`${blogUrl}${post.id.split('/')[1].replace(/\.md$/, '')}/`} class='glass-panel p-6 rounded-xl border-l-4 border-l-graphite-tertiary-container hover:-translate-y-1 transition-transform duration-300 block'>
            <p class='font-mono text-xs text-graphite-tertiary-container mb-2 uppercase'>{post.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' })}</p>
            <h4 class='font-geist text-xl font-medium text-graphite-primary mb-3'>{post.data.title}</h4>
            <p class='text-base text-graphite-on-surface-variant line-clamp-2'>{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script src='../scripts/hero-network.js'></script>
  <script src='../scripts/nav-highlight.js'></script>
</BaseLayout>
