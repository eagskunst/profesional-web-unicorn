---
import type { CollectionEntry } from 'astro:content';
import type { Language } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Pokedex from './Pokedex.astro';

interface Props {
  lang: Language;
  posts: CollectionEntry<'blog'>[];
}

const { lang, posts } = Astro.props;
const pageTitle = lang === 'es' ? 'Emmanuel Guerra - Ingeniero de Software Senior' : 'Emmanuel Guerra - Senior Software Engineer';
const pageDescription = lang === 'es'
  ? 'Portafolio de Emmanuel Guerra, Ingeniero de Software Senior con 8 años de experiencia en mobile, backend e integraciones de IA.'
  : 'Portfolio of Emmanuel Guerra, Senior Software Engineer with 8 years of experience in mobile, backend, and AI integrations.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image='/self_photo_new.png'
  lang={lang}
>
  <Nav lang={lang} />

  <main class='pt-[68px]'>
    <Pokedex lang={lang} posts={posts} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
